NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-este-secreto-en-produccion

# --- Oracle Autonomous Database (Cloud) ---
# 1) Descargar el wallet desde la consola de OCI (DB Connection > Download Wallet).
# 2) Descomprimirlo en una carpeta segura del servidor.
# 3) Apuntar ORACLE_WALLET_DIR a esa carpeta.
# 4) ORACLE_CONNECT_STRING = uno de los alias del tnsnames.ora del wallet
#    (típicamente <dbname>_high, <dbname>_medium o <dbname>_low).
ORACLE_USER=ADMIN
ORACLE_PASSWORD=tu_password_segura
ORACLE_CONNECT_STRING=agromanager_high
ORACLE_WALLET_DIR=C:\Users\marti\oracle_wallets\agromanager
ORACLE_WALLET_PASSWORD=

ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# 'thin' (default, no requiere Oracle Client) o 'thick' (requiere Instant Client).
ORACLE_CLIENT_MODE=thin
# Sólo si usas thick mode y el Instant Client no está en PATH:
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_13

# --- IA (opcional) ---
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
