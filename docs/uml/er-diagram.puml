@startuml AgroManager - Diagrama Entidad-Relación (Chen)

' Truco para Chen ER en PlantUML estándar (sin @startchen):
'   state X <<choice>>  -> renderiza como ROMBO  (relaciones)
'   state X             -> renderiza como rectángulo (entidades)
'   state X <<weak>>    -> rectángulo con estilo distinto (entidades débiles)
'
' Las flechas direccionales son una concesión al motor de state machine,
' pero las cardinalidades quedan claras con las etiquetas "1" y "N".

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #475569
skinparam ArrowFontColor #1E293B

skinparam state {
  BackgroundColor       #F8FAFC
  BorderColor           #334155
  FontColor             #0F172A

  BackgroundColor<<weak>>   #FEF3C7
  BorderColor<<weak>>       #B45309
  FontColor<<weak>>         #7C2D12

  BackgroundColor<<choice>> #FCD34D
  BorderColor<<choice>>     #92400E
}

hide empty description

' =============================================================================
' ENTIDADES FUERTES (rectángulo)
' =============================================================================

state Usuario : __id__ (PK)\nnombre\nemail (UK)\npassword_hash\nrol\nestado\ncreated_at\nupdated_at
state Parcela : __id__ (PK)\nnombre\nhectareas\ncultivo\nestado\ninversion
state Trabajador : __id__ (PK)\nnombre\ncargo\nsalario\nhoras_trabajadas\nestado
state Maquinaria : __id__ (PK)\nnombre\ntipo\nestado\nultimo_mantenimiento\nproximo_mantenimiento
state Semilla : __id__ (PK)\ntipo\ncantidad\nproveedor\ncosto
state Plaga : __id__ (PK)\ncultivo\ntipo\nseveridad\ntratamiento\nfecha_detec
state Riego : __id__ (PK)\ntipo\nultimo_riego\nproximo_riego\nconsumo_agua
state Fertilizante : __id__ (PK)\nnombre\ncantidad\nfecha_aplicacion\ncosto
state Ingreso : __id__ (PK)\nconcepto\nmonto\nfecha\ntipo
state Egreso : __id__ (PK)\nconcepto\nmonto\nfecha\ntipo\ncategoria
state Campana : __id__ (PK)\nnombre\nfecha_inicio\nfecha_fin\nhectareas\nlotes\ninversion_total\ngastos_operativos\ningreso_total\nrendimiento_ha\nproduccion_total
state Cambio : __id__ (PK)\ntitulo\ndescripcion\ntipo\ncreated_at

' =============================================================================
' ENTIDADES DÉBILES (estilo distinto - su PK depende de Campana)
' =============================================================================

state CampanaDiario <<weak>> : __id__ (PK)\nfecha\nhectareas_cortadas\nbultos\nnotas
state Remision <<weak>> : __id__ (PK)\nfecha\nnombre_conductor\nvehiculo_placa\norigen\ndestino\ncantidad\nvariedad\nvalor_flete

' =============================================================================
' RELACIONES (rombos via <<choice>>)
' =============================================================================

state Administra <<choice>>
state Emplea     <<choice>>
state Posee      <<choice>>
state Inventaria <<choice>>
state Detecta    <<choice>>
state Programa   <<choice>>
state Aplica     <<choice>>
state Cobra      <<choice>>
state Paga       <<choice>>
state Planifica  <<choice>>
state Publica    <<choice>>

state Origina    <<choice>>
state IrrigaA    <<choice>>
state Fertiliza  <<choice>>

state Reporta    <<choice>>
state Despacha   <<choice>>

' =============================================================================
' CARDINALIDADES
' =============================================================================

' --- Multi-tenant: Usuario es propietario (1:N) ---
Usuario --> Administra : "1"
Administra --> Parcela : "N"

Usuario --> Emplea : "1"
Emplea --> Trabajador : "N"

Usuario --> Posee : "1"
Posee --> Maquinaria : "N"

Usuario --> Inventaria : "1"
Inventaria --> Semilla : "N"

Usuario --> Detecta : "1"
Detecta --> Plaga : "N"

Usuario --> Programa : "1"
Programa --> Riego : "N"

Usuario --> Aplica : "1"
Aplica --> Fertilizante : "N"

Usuario --> Cobra : "1"
Cobra --> Ingreso : "N"

Usuario --> Paga : "1"
Paga --> Egreso : "N"

Usuario --> Planifica : "1"
Planifica --> Campana : "N"

Usuario --> Publica : "1"
Publica --> Cambio : "N"

' --- Inter-módulo: Parcela como nodo operativo ---
Parcela --> Origina : "1"
Origina --> Ingreso : "0..N"

Parcela --> IrrigaA : "1"
IrrigaA --> Riego : "0..N"

Parcela --> Fertiliza : "1"
Fertiliza --> Fertilizante : "0..N"

' --- Identificadoras hacia entidades débiles ---
Campana --> Reporta : "1"
Reporta --> CampanaDiario : "N"

Campana --> Despacha : "1"
Despacha --> Remision : "N"

@enduml
