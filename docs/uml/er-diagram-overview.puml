@startuml AgroManager - ER Conceptual (vista panorámica)

' Versión de alto nivel: solo entidades y relaciones, sin atributos.
' Para detalle ver er-diagram.puml.
'
' Mismo truco que el detallado:
'   state X <<choice>> -> rombo (relaciones)
'   state X            -> rectángulo (entidades)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #475569
skinparam ArrowFontColor #1E293B

skinparam state {
  BackgroundColor       #F8FAFC
  BorderColor           #334155
  FontColor             #0F172A

  BackgroundColor<<weak>>   #FEF3C7
  BorderColor<<weak>>       #B45309

  BackgroundColor<<choice>> #FCD34D
  BorderColor<<choice>>     #92400E
}

hide empty description

' Entidades fuertes
state Usuario
state Parcela
state Trabajador
state Maquinaria
state Semilla
state Plaga
state Riego
state Fertilizante
state Ingreso
state Egreso
state Campana
state Cambio

' Entidades débiles
state CampanaDiario <<weak>>
state Remision <<weak>>

' Relaciones (rombos)
state Administra <<choice>>
state Emplea     <<choice>>
state Posee      <<choice>>
state Inventaria <<choice>>
state Detecta    <<choice>>
state Programa   <<choice>>
state Aplica     <<choice>>
state Cobra      <<choice>>
state Paga       <<choice>>
state Planifica  <<choice>>
state Publica    <<choice>>
state Origina    <<choice>>
state IrrigaA    <<choice>>
state Fertiliza  <<choice>>
state Reporta    <<choice>>
state Despacha   <<choice>>

' Multi-tenant Usuario (1:N)
Usuario --> Administra : "1"
Administra --> Parcela : "N"

Usuario --> Emplea : "1"
Emplea --> Trabajador : "N"

Usuario --> Posee : "1"
Posee --> Maquinaria : "N"

Usuario --> Inventaria : "1"
Inventaria --> Semilla : "N"

Usuario --> Detecta : "1"
Detecta --> Plaga : "N"

Usuario --> Programa : "1"
Programa --> Riego : "N"

Usuario --> Aplica : "1"
Aplica --> Fertilizante : "N"

Usuario --> Cobra : "1"
Cobra --> Ingreso : "N"

Usuario --> Paga : "1"
Paga --> Egreso : "N"

Usuario --> Planifica : "1"
Planifica --> Campana : "N"

Usuario --> Publica : "1"
Publica --> Cambio : "N"

' Inter-módulo
Parcela --> Origina : "1"
Origina --> Ingreso : "0..N"

Parcela --> IrrigaA : "1"
IrrigaA --> Riego : "0..N"

Parcela --> Fertiliza : "1"
Fertiliza --> Fertilizante : "0..N"

' Identificadoras
Campana --> Reporta : "1"
Reporta --> CampanaDiario : "N"

Campana --> Despacha : "1"
Despacha --> Remision : "N"

@enduml
